{ 
    "position": "top", 
    "modules-left": ["cpu","memory","temperature"],
    "modules-center": ["clock"],
    "modules-right": ["network","bluetooth","backlight","pulseaudio","battery"],

    "clock": {
	"format": "{:%H:%M}",
	"format-alt": "{:%a %d %h %Y}"
    },

    "battery": {
	"format": "{icon} {capacity}%",
	"format-discharging": "{icon} {capacity}%",
	"format-charging": "{icon} {capacity}%",
	"FORMAT-PLUGGED": "",
	"format-icons": {
	    "charging": ["󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂅"],
	    "default": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
	},
	"format-full": "󰂅"
    },

    "group/tray-expander": {
	"orientation": "inherit",
	"drawer": {
	    "transition-duration": 0,
	    "children-class": "tray-group-item"
	},
	"modules": ["custom/expand-icon", "tray"]
    },
    "custom/expand-icon": {
	"format": "",
	"tooltip": false,
	"on-scroll-up": "",
	"on-scroll-down": "",
	"on-scroll-left": "",
	"on-scroll-right": ""
    },

    "tray": {
	"icon-size": 16,
	"spacing": 17
    },

    "network": {
	"format-wifi": "󰤥 ",
	"format-ethernet": "󰀂 ",
	"format-disconnected": "󰤮 "
    },

    "bluetooth": {
	"format": "",
	"format-off": "󰂲",
	"format-disabled": "󰂲",
	"format-connected": "󰂱"
    },
    "pulseaudio": {
	"format": "{icon} {volume}%",
	"format-muted": " ",
	"format-icons": {
	    "headphone": " ",
	    "headset": " ",
	    "default": [" "]
	}
    },
    "backlight": {
	"format": "{icon} {percent}%",
	"format-icons": [""]
    },

    "cpu": {
	"format": " CPU {usage}%",
	"interval": 1
    },

    "memory": {
	"format": " RAM {used:0.1f}/8G",
	"interval": 5
    },

    "disk": {
	"format": " Disk {used}",
	"path": "/",
	"interval": 60
    },

    "temperature": {
	"format": " {temperatureC}°C",
	"critical-threshold": 85
    }

}
