{ 
    "position": "top", 
    "modules-left": ["cpu","memory","disk"],
    "modules-center": ["clock"],
    "modules-right": ["network","bluetooth","backlight","pulseaudio","battery"],

    "clock": {
	"format": "{:%d/%m/%Y  %A  %H:%M}"
    },

    "battery": {
	"format": "{icon} {capacity}%",
	"format-discharging": "{icon} {capacity}%",
	"format-charging": "{icon} {capacity}%",
	"FORMAT-PLUGGED": "",
	"format-icons": {
	    "charging": ["󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂅"],
	    "default": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
	},
	"format-full": "󰂅"
    },

    "network": {
	"format-wifi": "󰤥 ",
	"format-ethernet": "󰀂 ",
	"format-disconnected": "󰤮 "
    },

    "bluetooth": {
	"format": "",
	"format-off": "󰂲",
	"format-disabled": "󰂲",
	"format-connected": "󰂱"
    },
    "pulseaudio": {
	"format": "{icon} {volume}%",
	"format-muted": " ",
	"format-icons": {
	    "headphone": " ",
	    "headset": " ",
	    "default": [" "]
	}
    },
    "backlight": {
	"format": "{icon} {percent}%",
	"format-icons": [""]
    },

    "cpu": {
	"format": " CPU {usage}%",
	"interval": 2
    },

    "memory": {
	"format": " RAM {used:0.1f}/8G",
	"interval": 5
    },

    "disk": {
	"format": " Disk {used}",
	"path": "/",
	"interval": 60
    }
}
